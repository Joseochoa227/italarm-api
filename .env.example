# Copiar como .env y completar. El archivo .env nunca se sube al repositorio.

# PostgreSQL local (docker compose)
POSTGRES_DB=italarm
POSTGRES_USER=italarm
POSTGRES_PASSWORD=

# Conexión de la API
ITALARM_DB_URL=jdbc:postgresql://localhost:5432/italarm
ITALARM_DB_USUARIO=italarm
ITALARM_DB_CLAVE=

# Contraseña inicial de Jose y Victor (solo se aplica a usuarios sin contraseña)
ITALARM_CLAVE_INICIAL=

# Origen(es) del frontend permitidos por CORS, separados por coma
ITALARM_CORS_ORIGENES=http://localhost:5173

# Almacenamiento de archivos: "disco" en local, "s3" en el hosting
ITALARM_ALMACENAMIENTO=disco
ITALARM_ALMACENAMIENTO_CARPETA=./almacenamiento
ITALARM_URL_PUBLICA=http://localhost:8080
# Clave para firmar enlaces en modo disco (si se deja vacía se genera al arrancar)
ITALARM_ENLACES_CLAVE=

# Solo en modo s3 (Cloudflare R2, AWS S3, DigitalOcean Spaces)
ITALARM_S3_ENDPOINT=
ITALARM_S3_REGION=auto
ITALARM_S3_BUCKET=
ITALARM_S3_ACCESS_KEY=
ITALARM_S3_SECRET_KEY=
